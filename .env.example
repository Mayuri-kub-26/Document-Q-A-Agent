# LLM provider: mock | openai | ollama
LLM_PROVIDER=mock

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=openai
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Ollama (OpenAI-compatible local server)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# Tuning
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
TEMPERATURE=0.2
MAX_TOKENS=512
LOG_LEVEL=INFO
